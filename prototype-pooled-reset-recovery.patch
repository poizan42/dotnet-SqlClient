From c1aee41bc463d6c1de94ac989a36818ea801025d Mon Sep 17 00:00:00 2001
From: kb <kb@dbi-it.dk>
Date: Tue, 3 Nov 2026 17:52:24 +0100
Subject: [PATCH 2/5] PROTOTYPE: env-var gated wire trace and read-delay
 injection in TdsParserStateObject

SQLCLIENT_REPRO_TRACE=1 logs each write/read with SNI error, packet size and
first token; SQLCLIENT_REPRO_READ_DELAY_MS=n sleeps before posting each read.
Used to show that the error tokens for a refused pooled reset are lost when
the read is posted after the server's abortive disconnect.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../TdsParserStateObject.Multiplexer.cs       |  8 +++++
 .../SqlClient/Parser/TdsParserStateObject.cs  | 29 +++++++++++++++++++
 2 files changed, 37 insertions(+)

diff --git a/src/Microsoft.Data.SqlClient/src/Microsoft/Data/SqlClient/Parser/TdsParserStateObject.Multiplexer.cs b/src/Microsoft.Data.SqlClient/src/Microsoft/Data/SqlClient/Parser/TdsParserStateObject.Multiplexer.cs
index 327d507c8..ae717a504 100644
--- a/src/Microsoft.Data.SqlClient/src/Microsoft/Data/SqlClient/Parser/TdsParserStateObject.Multiplexer.cs
+++ b/src/Microsoft.Data.SqlClient/src/Microsoft/Data/SqlClient/Parser/TdsParserStateObject.Multiplexer.cs
@@ -15,6 +15,12 @@ namespace Microsoft.Data.SqlClient.Parser
 
