From 03dad392b7b1e951a9ffb582d99767b0b8a3ed33 Mon Sep 17 00:00:00 2001
From: kb <kb@dbi-it.dk>
Date: Tue, 3 Nov 2026 14:09:05 +0100
Subject: [PATCH 1/5] PROTOTYPE: recover from a pooled connection whose reset
 the server refuses

Two opt-in AppContext switches, for evaluation only (not for upstream as is):
- Switch.Microsoft.Data.SqlClient.Prototype.ValidatePooledResetOnCheckout:
  flush the deferred reset with a no-op batch during Activate; on failure
  doom the connection and let WaitHandleDbConnectionPool get another.
- Switch.Microsoft.Data.SqlClient.Prototype.DoomOnLoginDatabaseCollationChange:
  don't pool a session whose login database's collation changed (seen via
  ENV_COLLATION), since SQL Server will refuse to reset it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../Data/ProviderBase/DbConnectionInternal.cs |   7 ++
 .../Connection/SqlConnectionInternal.cs       | 108 ++++++++++++++++++
 .../WaitHandleDbConnectionPool.cs             |  15 ++-
 3 files changed, 128 insertions(+), 2 deletions(-)

diff --git a/src/Microsoft.Data.SqlClient/src/Microsoft/Data/ProviderBase/DbConnectionInternal.cs b/src/Microsoft.Data.SqlClient/src/Microsoft/Data/ProviderBase/DbConnectionInternal.cs
index 3d7217739..e366d7475 100644
--- a/src/Microsoft.Data.SqlClient/src/Microsoft/Data/ProviderBase/DbConnectionInternal.cs
+++ b/src/Microsoft.Data.SqlClient/src/Microsoft/Data/ProviderBase/DbConnectionInternal.cs
@@ -711,6 +711,13 @@ namespace Microsoft.Data.ProviderBase
         /// </returns>
         internal virtual bool IsConnectionAlive(bool throwOnException = false) => true;
 
+        /// <summary>
+        /// Set when activation failed because the server refused the deferred reset of this
+        /// pooled connection. Nothing the caller asked for has been sent at that point, so the
+        /// pool may discard this connection and vend another one instead of failing the Open.
+        /// </summary>
+        internal bool PooledResetRefused { get; private protected set; }
+
         /// <summary>
         /// Used by DbConnectionFactory to indicate that this object IS NOT part of a connection pool.
         /// </summary>
diff --git a/src/Microsoft.Data.SqlClient/src/Microsoft/Data/SqlClient/Connection/SqlConnectionInternal.cs b/src/Microsoft.Data.SqlClient/src/Microsoft/Data/SqlClient/Connection/SqlConnectionInternal.cs
index 6e8f94b7c..6c825ec1e 100644
--- a/src/Microsoft.Data.SqlClient/src/Microsoft/Data/SqlClient/Connection/SqlConnectionInternal.cs
+++ b/src/Microsoft.Data.SqlClient/src/Microsoft/Data/SqlClient/Connection/SqlConnectionInternal.cs
@@ -1240,6 +1240,16 @@ namespace Microsoft.Data.SqlClient.Connection
                     {
                         _currentSessionData._collation = rec._newCollation;
                     }
+
+                    if (rec._newCollation is not null)
+                    {
+                        if (!_fConnectionOpen && _recoverySessionData == null)
+                        {
+                            _loginCollation = rec._newCollation;
+                        }
+
+                        _currentCollation = rec._newCollation;
+                    }
                     break;
 
                 case TdsEnums.ENV_CHARSET:
@@ -2179,6 +2189,20 @@ namespace Microsoft.Data.SqlClient.Connection
                 ResetSessionIsolationLevel(timeout);
             }
 
+            // PROTOTYPE: flush the deferred reset now, on checkout, instead of piggybacking it on
+            // the caller's first request. If the server refuses it (e.g. 4021 / 18456 state 50
+            // after the login database's collation changed), the connection is doomed and marked
+            // so the pool can discard it and vend another; nothing of the caller's has been sent.
+            // A connection bound to a transaction is excluded: a replacement could not take over
+            // its server-side transaction.
+            if (s_validatePooledResetOnCheckout &&
+                _parser._fResetConnection &&
+                EnlistedTransaction is null &&
+                !IsTransactionRoot)
+            {
+                FlushPendingReset(timeout);
+            }
+
             // When we're required to automatically enlist in transactions and there is one we
             // enlist in it. On the other hand, if there isn't a transaction, and we are
             // currently enlisted in one, then we un-enlist from it.
@@ -2226,6 +2250,15 @@ namespace Microsoft.Data.SqlClient.Connection
                     DoomThisConnection();
                 }
 
+                // PROTOTYPE: the server will refuse to reset this session, so don't pool it.
+                if (s_doomOnLoginDatabaseCollationChange && !IsConnectionDoomed && LoginDatabaseCollationChanged)
+                {
+                    SqlClientEventSource.Log.TryTraceEvent(
+                        "SqlConnectionInternal.Deactivate | Info | Object ID {0}, login database collation changed; not pooling.",
+                        ObjectID);
+                    DoomThisConnection();
+                }
+
                 // If we're deactivating with a delegated transaction, we should not be cleaning up
                 // the parser just yet, that will cause our transaction to be rolled back and the
                 // connection to be reset. We'll get called again once the delegated transaction is
@@ -4274,6 +4307,8 @@ namespace Microsoft.Data.SqlClient.Connection
             // flag's value stops mattering.
             _isolationLevelDirty = false;
 
+            bool resetWasPending = _parser._fResetConnection;
+
             // Dedicated Synapse pools reject this SET statement with error 104409. Their effective
             // isolation is controlled by the service/database configuration, not this reset.
             if (ADP.IsAzureSynapseDedicatedPoolEndpoint(ConnectionOptions.DataSource))
@@ -4326,11 +4361,84 @@ namespace Microsoft.Data.SqlClient.Connection
                 // try/catch that calls ReturnInternalConnection and rethrows, so the doomed
                 // connection is destroyed rather than pooled and the caller's Open observes the
                 // original error instead of receiving an unusable connection.
+                //
+                // PROTOTYPE: this batch also carried any pending reset, and nothing of the
+                // caller's has been sent, so the pool may replace the connection.
+                PooledResetRefused = s_validatePooledResetOnCheckout && resetWasPending;
                 DoomThisConnection();
                 throw;
             }
         }
 
+        // PROTOTYPE switches; a real change would go through LocalAppContextSwitches.
+        private static readonly bool s_validatePooledResetOnCheckout =
+            AppContext.TryGetSwitch("Switch.Microsoft.Data.SqlClient.Prototype.ValidatePooledResetOnCheckout", out bool v) && v;
+
+        private static readonly bool s_doomOnLoginDatabaseCollationChange =
+            AppContext.TryGetSwitch("Switch.Microsoft.Data.SqlClient.Prototype.DoomOnLoginDatabaseCollationChange", out bool d) && d;
+
+        // PROTOTYPE: sends a no-op batch so the pending reset flag goes out on its own, then reads
+        // the response. Mirrors ResetSessionIsolationLevel's error handling. (An empty batch gets
+        // no response from SQL Server, so it has to be a statement.)
+        private void FlushPendingReset(TimeoutTimer timeout)
+        {
+            if (IsConnectionDoomed)
+            {
+                return;
+            }
+
+            try
+            {
+                long timeoutMilliseconds = 0;
+                if (!timeout.IsInfinite)
+                {
+                    timeoutMilliseconds = timeout.MillisecondsRemaining;
+                    if (timeoutMilliseconds == 0)
+                    {
+                        throw ADP.IsolationLevelResetTimeout();
+                    }
+                }
+
+                ValidateConnectionForExecute(null);
+
+                _parser.TdsExecuteSQLBatchWithMillisecondTimeout(
+                        text: "DECLARE @_ INT;",
+                        timeoutMilliseconds: timeoutMilliseconds,
+                        notificationRequest: null,
+                        stateObj: _parser._physicalStateObj,
+                        sync: true);
+                _parser.Run(RunBehavior.UntilDone, null, null, null, _parser._physicalStateObj);
+
+                if (_parser.State is not TdsParserState.OpenLoggedIn)
+                {
+                    throw ADP.ClosedConnectionError();
+                }
+            }
+            catch (Exception e) when (ADP.IsCatchableExceptionType(e))
+            {
+                SqlClientEventSource.Log.TryTraceEvent(
+                    "SqlConnectionInternal.FlushPendingReset | Info | Object ID {0}, pooled connection reset refused: {1}",
+                    ObjectID, e.Message);
+                PooledResetRefused = true;
+                DoomThisConnection();
+                throw;
+            }
+        }
+
+        // PROTOTYPE: collation the server reported for the login database at login, and the
+        // latest collation ENVCHANGE since.
+        private SqlCollation _loginCollation;
+        private SqlCollation _currentCollation;
+
+        // PROTOTYPE: true when the session is back in its login database but that database's
+        // collation is no longer the one it logged in under, which SQL Server refuses to reset
+        // ("Current collation did not match the database's collation during connection reset").
+        private bool LoginDatabaseCollationChanged =>
+            _loginCollation is not null &&
+            _currentCollation is not null &&
+            !SqlCollation.Equals(_loginCollation, _currentCollation) &&
+            string.Equals(CurrentDatabase, _originalDatabase, StringComparison.OrdinalIgnoreCase);
+
         /// <summary>
         /// Decides whether a connection reset must preserve the server-side transaction, i.e.
         /// whether <c>ST_RESET_CONNECTION_PRESERVE_TRANSACTION</c> should be sent instead of a
diff --git a/src/Microsoft.Data.SqlClient/src/Microsoft/Data/SqlClient/ConnectionPool/WaitHandleDbConnectionPool.cs b/src/Microsoft.Data.SqlClient/src/Microsoft/Data/SqlClient/ConnectionPool/WaitHandleDbConnectionPool.cs
index c628c0993..0420d5e1e 100644
--- a/src/Microsoft.Data.SqlClient/src/Microsoft/Data/SqlClient/ConnectionPool/WaitHandleDbConnectionPool.cs
+++ b/src/Microsoft.Data.SqlClient/src/Microsoft/Data/SqlClient/ConnectionPool/WaitHandleDbConnectionPool.cs
@@ -964,7 +964,7 @@ namespace Microsoft.Data.SqlClient.ConnectionPool
 #if NETFRAMEWORK
         [SuppressMessage("Microsoft.Reliability", "CA2001:AvoidCallingProblematicMethods")] // copied from Triaged.cs
 #endif
-        private bool TryGetConnection(DbConnection owningObject, uint waitForMultipleObjectsTimeout, bool allowCreate, bool onlyOneCheckConnection, TimeoutTimer timeout, out DbConnectionInternal connection)
+        private bool TryGetConnection(DbConnection owningObject, uint waitForMultipleObjectsTimeout, bool allowCreate, bool onlyOneCheckConnection, TimeoutTimer timeout, out DbConnectionInternal connection, int resetRetriesLeft = 3)
         {
             DbConnectionInternal obj = null;
             Transaction transaction = null;
@@ -1140,7 +1140,18 @@ namespace Microsoft.Data.SqlClient.ConnectionPool
                 // that disconnect unpaired and drive the active-soft-connects gauge negative.
                 // Counted inside this branch so that no connection vended means no soft connect.
                 Metrics.SoftConnectRequest();
-                PrepareConnection(owningObject, obj, transaction, timeout);
+                try
+                {
+                    PrepareConnection(owningObject, obj, transaction, timeout);
+                }
+                catch when (obj.PooledResetRefused && resetRetriesLeft > 0 && !timeout.IsExpired)
+                {
+                    // PROTOTYPE: the server refused to reset this pooled connection before anything
+                    // of the caller's was sent. PrepareConnection has returned it doomed, so it has
+                    // been destroyed; get another one (an idle one or a new physical connection).
+                    SqlClientEventSource.Log.TryPoolerTraceEvent("<prov.DbConnectionPool.GetConnection|RES|CPOOL> {0}, Connection {1}, reset refused by server; discarded, retrying.", Id, obj.ObjectID);
+                    return TryGetConnection(owningObject, waitForMultipleObjectsTimeout, allowCreate, onlyOneCheckConnection, timeout, out connection, resetRetriesLeft - 1);
+                }
             }
 
             connection = obj;
